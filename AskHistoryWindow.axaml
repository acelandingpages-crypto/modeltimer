<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModelTimer"
        x:Class="ModelTimer.AskHistoryWindow"
        Title="Ask History"
        Width="560"
        Height="700"
        MinWidth="480"
        MinHeight="500"
        Background="#FF1E1E1E"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ShowInTaskbar="False">

  <Grid RowDefinitions="30,Auto,*,Auto">
    <!-- Draggable title bar -->
    <Border Grid.Row="0" Background="#FFcba6f7" PointerPressed="TitleBar_PointerPressed">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="Ask History" Foreground="Black" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Button Grid.Column="1" Name="CloseButton" Width="28" Height="28" Background="#FFFF0000" Click="CloseButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
          <TextBlock Text="X" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Button>
      </Grid>
    </Border>

    <!-- Search bar -->
    <Border Grid.Row="1" Padding="16,14,16,14" Background="#FF252526" BorderBrush="#FFcba6f7" BorderThickness="0,0,0,3">
      <StackPanel Spacing="8">
        <TextBlock Text="Search shift reports and fan CRM notes" Foreground="White" FontSize="13" FontWeight="Bold"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Name="QueryTextBox" PlaceholderText="e.g. Aria, refund, chargeback..." Background="#FF3E3E42" Foreground="White" BorderBrush="#FF555555" BorderThickness="1" Padding="8" Height="34" KeyDown="QueryTextBox_KeyDown"/>
          <Button Grid.Column="1" Name="BtnSearch" Content="Search" Height="34" Width="90" Background="#FFa6e3a1" Foreground="Black" Click="BtnSearch_Click"/>
        </Grid>
        <Button Name="BtnAskAi" Content="✨ Ask AI to summarize these matches" Height="30" Background="#FF3E3E42" Foreground="White" FontSize="12" HorizontalAlignment="Stretch" Click="BtnAskAi_Click"/>
        <Border Name="AiAnswerBorder" Background="#FF1E1E1E" BorderBrush="#FFcba6f7" BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="False">
          <TextBlock Name="AiAnswerText" Text="" Foreground="#FFa6e3a1" FontSize="13" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </Border>

    <!-- Results -->
    <ScrollViewer Grid.Row="2" Padding="16,10,16,10">
      <StackPanel Spacing="16">
        <StackPanel Spacing="6">
          <TextBlock Text="Shift Reports" Foreground="#FFa6e3a1" FontSize="13" FontWeight="Bold"/>
          <StackPanel Name="ShiftResultsPanel" Spacing="8"/>
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="Fan / CRM Notes" Foreground="#FFcba6f7" FontSize="13" FontWeight="Bold"/>
          <StackPanel Name="CrmResultsPanel" Spacing="8"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Name="HintText" Text="Type a keyword or question above, then press Search." Foreground="#FF888888" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
  </Grid>
</Window>

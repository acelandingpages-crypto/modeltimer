<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModelTimer"
        x:Class="ModelTimer.NewShiftWindow"
        Title="Set new shift"
        Width="400"
        Height="420"
        MinWidth="400"
        MinHeight="400"
        Background="#FF1E1E1E"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ShowInTaskbar="False">

  <Grid RowDefinitions="30,*" >
    <!-- Draggable title bar -->
    <Border Grid.Row="0" Background="#FFcba6f7" PointerPressed="TitleBar_PointerPressed">
      <TextBlock Text="Set new shift" Foreground="Black" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>

    <!-- Main content -->
    <Border Grid.Row="1" Padding="20,20,20,50" CornerRadius="0" Background="#FF252526" BorderBrush="#FFcba6f7" BorderThickness="3">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
        <!-- Row 0: Model -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <TextBlock Grid.Column="0" Text="Model" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="70"/>
          <ComboBox Grid.Column="1" Name="ModelComboBox" IsEditable="True" VerticalAlignment="Center" Background="#FF3E3E42" Foreground="White" HorizontalAlignment="Stretch" PointerPressed="SetActiveComboBox" SelectionChanged="SetActiveComboBox" BorderBrush="#FF555555" BorderThickness="1"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Name="BtnModelAdd" Content="+" Width="28" Height="26" Background="#FF107C10" Foreground="White" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="BtnAdd_Click" ToolTip.Tip="Add"/>
            <Button Name="BtnModelEdit" Content="*" Width="28" Height="26" Background="#FF0E639C" Foreground="White" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="BtnEdit_Click" ToolTip.Tip="Edit selected"/>
            <Button Name="BtnModelDelete" Content="-" Width="28" Height="26" Background="#FFC42B1C" Foreground="White" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="BtnDelete_Click" ToolTip.Tip="Delete selected"/>
          </StackPanel>
        </Grid>

        <!-- Row 1: Moderator -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <TextBlock Grid.Column="0" Text="Moderator" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="70"/>
          <ComboBox Grid.Column="1" Name="ModeratorComboBox" IsEditable="True" VerticalAlignment="Center" Background="#FF3E3E42" Foreground="White" HorizontalAlignment="Stretch" PointerPressed="SetActiveComboBox" SelectionChanged="SetActiveComboBox" BorderBrush="#FF555555" BorderThickness="1"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Name="BtnModeratorAdd" Content="+" Width="28" Height="26" Background="#FF107C10" Foreground="White" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="BtnAdd_Click" ToolTip.Tip="Add"/>
            <Button Name="BtnModeratorEdit" Content="*" Width="28" Height="26" Background="#FF0E639C" Foreground="White" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="BtnEdit_Click" ToolTip.Tip="Edit selected"/>
            <Button Name="BtnModeratorDelete" Content="-" Width="28" Height="26" Background="#FFC42B1C" Foreground="White" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="BtnDelete_Click" ToolTip.Tip="Delete selected"/>
          </StackPanel>
        </Grid>

        <!-- Row 2: Separator -->
        <Border Grid.Row="2" Height="3" Background="#FF555555" Margin="0,5,0,5"/>

        <!-- Row 3: Shift notes label -->
        <TextBlock Grid.Row="3" Text="Shift notes (optional)" Foreground="White" FontSize="14" FontWeight="Bold"/>

        <!-- Row 4: Shift notes textbox -->
        <TextBox Grid.Row="4" Name="ShiftNotesTextBox" Background="#FF3E3E42" Foreground="White" BorderThickness="1" BorderBrush="#FF555555" Padding="8" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True"/>

        <!-- Row 5: Set shift duration goal -->
        <TextBlock Grid.Row="5" Text="Set shift duration goal" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,10,0,0"/>

        <!-- Row 6: Duration dropdowns in two columns -->
        <Grid Grid.Row="6" ColumnDefinitions="*,*" ColumnSpacing="15" VerticalAlignment="Center">
          <StackPanel Grid.Column="0" Spacing="5">
            <TextBlock Text="Hours" Foreground="White" FontSize="12"/>
            <ComboBox Name="HoursComboBox" HorizontalAlignment="Stretch" Height="30" Background="#FF3E3E42" Foreground="White" VerticalAlignment="Center" SelectionChanged="Duration_SelectionChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="Minutes" Foreground="White" FontSize="12"/>
            <ComboBox Name="MinutesComboBox" HorizontalAlignment="Stretch" Height="30" Background="#FF3E3E42" Foreground="White" VerticalAlignment="Center" SelectionChanged="Duration_SelectionChanged"/>
          </StackPanel>
        </Grid>

        <!-- Row 7: Buttons in two columns -->
        <Grid Grid.Row="7" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,15,0,15">
          <Button Grid.Column="0" Name="BtnCancel" Content="Cancel" Height="28" Background="#FFFF0000" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" Click="BtnCancel_Click"/>
          <Button Grid.Column="1" Name="BtnConfirm" Content="Start Shift" Height="28" Background="#FFa6e3a1" Foreground="Black" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" Click="BtnConfirm_Click"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
